# Supabase (get from https://supabase.com/dashboard → Project Settings → API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Groq API key for scan AI (calls Groq directly from the app).
# Get a free key at https://console.groq.com (no card required for free tier).
EXPO_PUBLIC_GROQ_API_KEY=your_groq_api_key

# Optional: USDA FoodData Central API key (free at https://fdc.nal.usda.gov/api-key-signup.html).
# Adds US branded-food coverage. Leave empty to skip.
# EXPO_PUBLIC_USDA_FDC_API_KEY=

# Optional: Barcode Lookup API key for extra product coverage (US/international).
# Get a free test key at https://www.barcodelookup.com/api. Leave empty to skip.
# EXPO_PUBLIC_BARCODE_LOOKUP_API_KEY=
EXPO_PUBLIC_USDA_FDC_API_KEY=your_usda_fdc_api_key

# RevenueCat (public SDK keys + entitlement identifier)
# Get platform keys from https://app.revenuecat.com/projects → API keys
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=test_itpLiXEqhztAiHeYOJmAakajdQi
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=test_itpLiXEqhztAiHeYOJmAakajdQi
# Entitlement identifier configured in RevenueCat (e.g. premium_access)
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=pro
